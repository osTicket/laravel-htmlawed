{
    "name": "osticket/laravel-htmlawed",
    "description": "A typed Laravel integration for the htmLawed HTML sanitizer",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Rotich",
            "email": "peter@osticket.com",
            "homepage": "https://osticket.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "htmlawed/htmlawed": "~1.2.15",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "osTicket\\Htmlawed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "osTicket\\Htmlawed\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "osTicket\\Htmlawed\\HtmlawedServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint",
        "format:check": "pint --test",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
